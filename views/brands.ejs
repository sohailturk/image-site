<%- include('./partials/head') %>
<%- include('./partials/header') %>

<main class="container">
  <h1>Car Brands</h1>
  <p class="subtitle">Explore our gallery by manufacturer.</p>

  <div class="car-grid">
    <% brands.forEach(brand => { %>
      <article class="car-card brand-card">
        <div class="car-info">
          <h2 class="car-name"><%= brand %></h2>
          <a href="/" class="btn">View Gallery</a>
        </div>
      </article>
    <% }); %>
  </div>
</main>

<%- include('./partials/footer') %>
